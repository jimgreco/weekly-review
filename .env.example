# ---- Review site (src/server.js, on the EC2 host) ----

# Where the email goes.
REVIEW_EMAIL=you@example.com
# Public origin of the site; links in the email point here.
PUBLIC_URL=https://review.example.com
# At least 32 random characters: openssl rand -base64 48. Rotating it kills old links.
LINK_SECRET=
# Hex SHA-256 of REVIEW_INGEST_TOKEN. Unset = the routine cannot post reviews.
INGEST_TOKEN_SHA256=
DATA_DIR=/data
PORT=8790
# Email via Resend (same account as Week of Us works; the From domain must be verified there).
RESEND_API_KEY=
REVIEW_EMAIL_FROM=Weekly Review <review@weekofus.com>

# ---- Weekly routine (src/cli.js collect/publish, in the cloud environment) ----

REVIEW_TIMEZONE=America/New_York
# Each app's origin and its read-only weekly-summary token (docs/weekly-summary-contract.md).
MACROS_API_URL=https://macros.example.com
MACROS_SUMMARY_TOKEN=
WORKOUTS_API_URL=https://workouts.example.com
WORKOUTS_SUMMARY_TOKEN=
SPENDING_API_URL=https://spending.example.com
SPENDING_SUMMARY_TOKEN=
CHECKLIST_API_URL=https://checklist.example.com
CHECKLIST_SUMMARY_TOKEN=
PLANNER_API_URL=https://weekofus.com
PLANNER_SUMMARY_TOKEN=
# The review site and the plaintext ingest token.
REVIEW_SITE_URL=https://review.example.com
REVIEW_INGEST_TOKEN=

# Cloud routine only: tokens are network secrets on the cloud environment, so the
# session has URLs but no tokens. Leave unset for local runs with tokens above.
# AUTH_VIA_PROXY=1
# NODE_USE_ENV_PROXY=1
