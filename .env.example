# Whose week to review; also where the email goes.
REVIEW_EMAIL=you@example.com
REVIEW_TIMEZONE=America/New_York
# 0 = Sunday. The review covers the Monday–Sunday week containing the send time.
REVIEW_SEND_DAY=0
REVIEW_SEND_HOUR=18

# Public origin of this service (links in the email point here).
PUBLIC_URL=https://review.example.com
# At least 32 random characters: openssl rand -base64 48. Rotating it kills old links.
LINK_SECRET=
DATA_DIR=/data
PORT=8790

# SELECT-only role from sql/readonly-role.sql.
MACROS_DATABASE_URL=postgresql://weekly_review_ro:PASSWORD@db:5432/macro_tracker
SPENDING_DATABASE_URL=postgresql://weekly_review_ro:PASSWORD@db:5432/spending
DAILY_DATABASE_URL=postgresql://weekly_review_ro:PASSWORD@db:5432/daily_checklist
PLANNER_DATABASE_URL=postgresql://weekly_review_ro:PASSWORD@db:5432/common_week
PGSSL=false
# Only if your spending account is an invited reader of someone else's ledger.
SPENDING_OWNER_EMAIL=

# Workouts (DynamoDB-local has no IAM; any credentials work).
WORKOUT_TABLE_NAME=workout-planner
AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Narrative (optional; without a key the review is numbers only).
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-opus-5-5

# Email via Resend (same account as Week of Us works; the From domain must be verified there).
RESEND_API_KEY=
REVIEW_EMAIL_FROM=Weekly Review <review@weekofus.com>
